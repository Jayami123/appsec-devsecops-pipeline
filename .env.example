# Copy to .env only for a local run. Never commit .env. Names only: leave each value empty.
# F0-1 defines no runtime loader; the trimmed env contract is implemented in F0-2.
# Folder that holds the product checkouts. Cloud setup default when unset: $HOME/products.
PRODUCTS_ROOT=
# Run prefix shared by every entity a run creates (set by the harness in later lanes).
P5_RUN_ID=
# Product base URLs (local addresses only).
CAL_BASE_URL=
CAL_API_BASE_URL=
DOCUMENSO_BASE_URL=
MEDUSA_BASE_URL=
TWENTY_BASE_URL=
# Read-only oracle database URLs (the owner-role URL is never read by test code).
CAL_DB_URL=
DOCUMENSO_DB_URL=
MEDUSA_DB_URL=
TWENTY_DB_URL=
# Webhook receiver: comma-separated explicit IP literals and a port.
P2_RECEIVER_HOSTS=
P2_RECEIVER_PORT=
# Passwords for the two database roles (never committed; generated outside this repository).
P2_QA_RO_PASSWORD=
P2_QA_FIXTURE_PASSWORD=
# Stripe webhook signing secret (med-stripe job only; never committed).
STRIPE_WEBHOOK_SECRET=
# Read-only oracle statement timeout in milliseconds.
P2_DB_STATEMENT_TIMEOUT_MS=
